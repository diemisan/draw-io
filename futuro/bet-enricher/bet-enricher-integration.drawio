        <mxCell id="gEPJv5nczazuLBSkl6x0-29" parent="LJLtGPxYAIXRh8l6847R-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="dl bet place/settle" vertex="1">
