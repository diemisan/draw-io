        <mxCell id="cybcan_RkWAXxnsDBR16-9" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p data-renderer-start-pos=&quot;14&quot; data-local-id=&quot;6974e730-f272-48c7-a92d-1cc35a209840&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;BetCaptured: &lt;/b&gt;Published when a bet placement request is received and validated for processing. This event marks the start of the validation sequence and creates an audit trail from request receipt.&lt;/p&gt;&lt;p data-renderer-start-pos=&quot;199&quot; data-local-id=&quot;7a724380-a1f0-46ca-859a-9d487e6c94b7&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;One event is published per bet in the request.&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="730" x="80" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-10" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;p data-renderer-start-pos=&quot;14&quot; data-local-id=&quot;b2f0a67f-caed-4ba9-a644-8308508f4c62&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;BetPlaced: &lt;/b&gt;Published when a bet is successfully placed. All validations passed, the stake was debited&lt;br&gt; from the player&#39;s wallet, and the bet was recorded in the database. One event is published per bet in the request.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="850" x="67" y="220" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-11" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;p data-renderer-start-pos=&quot;14&quot; data-local-id=&quot;e638ad25-9b7a-48ae-b2fb-38f210d09281&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;BetAccepted: &lt;/b&gt;Published when all validations pass for a bet and it is ready for placement execution. &lt;br/&gt;This event represents a successfully validated bet.One event is published per bet in the request.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="740" x="70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-14" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;p data-renderer-start-pos=&quot;14&quot; data-local-id=&quot;4a54b41b-aa6b-44a7-bcf9-9c8e359a12eb&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;BetFailed: &lt;/b&gt;Published when a bet could not be completed due to technical or infrastructure issues. The bet passed &lt;br/&gt;all validations but could not be executed due to system failures. One event is published per failed bet.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="850" x="70" y="290" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-16" parent="cybcan_RkWAXxnsDBR16-1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-renderer-start-pos=&quot;33&quot; data-local-id=&quot;571f5e38-407f-4660-94ba-bd0bd196b86a&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre-wrap; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;b&gt;BetRejected: &lt;/b&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Published when a bet is rejected due to validation failures. The bet was deliberately refused based on business rules. One event is published per rejected bet.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="80" y="360" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-18" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;p data-renderer-start-pos=&quot;14&quot; data-local-id=&quot;29100e0c-29f8-4a70-bede-064be02cc230&quot; style=&quot;margin: 0.75em 0px 0px; padding: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 16px; line-height: 1.714; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46); text-align: start; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;BetRollback: &lt;/b&gt;Published when bet placement fails after wallet debit and the system automatically refunds the stake. &lt;br/&gt;This event ensures a complete audit trail of the rollback operation. One event is published per rollback.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="870" x="70" y="430" as="geometry" />
        </mxCell>
        <mxCell id="cybcan_RkWAXxnsDBR16-20" parent="cybcan_RkWAXxnsDBR16-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;span style=&quot;color: rgb(41, 42, 46); font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; white-space-collapse: preserve; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;OperationsAlert:&lt;/b&gt; Published when an operational incident occurs that requires attention from the operations team. &lt;br/&gt;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(41, 42, 46); font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; white-space-collapse: preserve;&quot;&gt;Triggered during critical system events such as bet rollbacks, service failures, or threshold breaches.&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="860" x="80" y="510" as="geometry" />
        </mxCell>
