        <mxCell id="XRjs5EBPcDtm15hye_WL-255" parent="XRjs5EBPcDtm15hye_WL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="Settlement is a list because there might be re-settlements" vertex="1">
          <mxGeometry height="101" width="170" x="20" y="972" as="geometry" />
        </mxCell>
        <mxCell id="XRjs5EBPcDtm15hye_WL-256" edge="1" parent="XRjs5EBPcDtm15hye_WL-1" source="XRjs5EBPcDtm15hye_WL-257" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="XRjs5EBPcDtm15hye_WL-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XRjs5EBPcDtm15hye_WL-257" parent="XRjs5EBPcDtm15hye_WL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="The id is a customerId, it&#39;s included in all BetPlacement events as &quot;punterId&quot;" vertex="1">
          <mxGeometry height="146.5" width="110" x="10" y="253.5" as="geometry" />
        </mxCell>
        <mxCell id="Zwc3fUXyQVysQGIyi3fL-7" parent="XRjs5EBPcDtm15hye_WL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;" value="&lt;div&gt;&lt;b&gt;ticketId: &lt;/b&gt;Punter can bet on multiple Bets at the same time. These bets share the same ticketId. Individual BetPlacement/BetSettlement events are emitted per bet.&lt;/div&gt;&lt;div&gt;&lt;b&gt;betslipId:&lt;/b&gt; id generated&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;from BetCompilation (UUIDv7), used by fronted.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;betReference (Bet.reference):&lt;/b&gt;&amp;nbsp;id generated from BetCompilation (UUIDv7). Available in all the events. When there is a BetRollback, the punter can retry to place the bet, this id would not change. Meaning, we can get 2 BetCaptured events with same betReference.&lt;/div&gt;&lt;div&gt;&lt;b&gt;betId (Bet.id):&lt;/b&gt;&amp;nbsp;id generated on BetPlaced. UUIDv7, generated from data base.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;b&gt;betCode (Bet.code):&lt;/b&gt;&amp;nbsp;tag generated on BetAccepted event, for human readability) = {BRAND}-{YYYYMMDD}-{HHMM}-{RANDOM_5CHAR}&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="430" x="1010" y="1440" as="geometry" />
